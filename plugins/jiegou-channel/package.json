{
  "name": "@jiegou/claude-code-channel",
  "version": "0.2.0",
  "description": "MCP plugin connecting Claude Code to the JieGou platform \u2014 API tools and optional WebSocket channel",
  "type": "module",
  "main": "src/server.ts",
  "bin": {
    "jiegou-channel": "src/server.ts"
  },
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --watch src/server.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "mcp",
    "jiegou",
    "claude-code",
    "channel"
  ],
  "license": "MIT",
  "overrides": {
    "vite": "^7.3.2",
    "hono": "^4.12.14",
    "@hono/node-server": "^2.0.0",
    "esbuild@0": "^0.28.1"
  }
}
